<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-openvpn-profile">
    <comment>OpenVPN configuration</comment>
    <glob pattern="*.ovpn"/>
  </mime-type>
  <mime-type type="application/x-fluidity-connection">
    <comment>Fluidity connection</comment>
    <sub-class-of type="application/gzip"/>
    <glob pattern="*.fvpnz"/>
  </mime-type>
</mime-info>
