[Desktop Entry]
Type=Application
Name=Fluidity
GenericName=VPN Client
Comment=Connect to OpenVPN servers
Exec=fluidity-gtk %U
Icon=org.fluidityvpn.Fluidity
Terminal=false
Categories=Network;GTK;
