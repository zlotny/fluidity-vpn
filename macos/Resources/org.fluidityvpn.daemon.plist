<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.fluidityvpn.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/Fluidity/fluidityd</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/Fluidity/fluidityd.log</string>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
